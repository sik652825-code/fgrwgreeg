        parse_mode='Markdown'
    )

def add_sopr(update: Update, context: CallbackContext):
    if update.effective_user.id not in OWNER_IDS:
        update.message.reply_text("⛔ Нет прав")
        return
    args = context.args
    if len(args) < 2:
        update.message.reply_text("Использование: /sopr название цена")
        return
    item_id = str(db.next_id)
    db.next_id += 1
    db.sopr_items[item_id] = {"name": args[0], "price": args[1]}
    db.save()
    update.message.reply_text(f"✅ Добавлено! ID: {item_id}")

def add_thing(update: Update, context: CallbackContext):
    if update.effective_user.id not in OWNER_IDS:
        update.message.reply_text("⛔ Нет прав")
        return
    args = context.args
    if len(args) < 2:
        update.message.reply_text("Использование: /things название цена")
        return
    item_id = str(db.next_id)
    db.next_id += 1
    db.things_items[item_id] = {"name": args[0], "price": args[1]}
    db.save()
    update.message.reply_text(f"✅ Добавлено! ID: {item_id}")

def piar_command(update: Update, context: CallbackContext):
    if update.effective_user.id not in OWNER_IDS:
        update.message.reply_text("⛔ Нет прав")
        return
    args = context.args
    if not args:
        update.message.reply_text("Использование: /piar ссылка [дни] [часы] [минуты]")
        return

    link = args[0]
    chat_id = None
    if "t.me/" in link:
        username = link.split("t.me/")[-1].split('/')[0].split('?')[0]
        try:
            chat = context.bot.get_chat(f"@{username}")
            chat_id = chat.id
        except:
            update.message.reply_text(f"❌ Не удалось найти канал {username}")
            return
    else:
        update.message.reply_text("❌ Неверная ссылка. Пример: https://t.me/durov")
        return

    until = None
    if len(args) >= 2:
        days = int(args[1]) if len(args) > 1 else 0
        hours = int(args[2]) if len(args) > 2 else 0
        minutes = int(args[3]) if len(args) > 3 else 0
        if days > 0 or hours > 0 or minutes > 0:
            until = datetime.now(MSK_TZ) + timedelta(days=days, hours=hours, minutes=minutes)

    db.pending_subscriptions[str(chat_id)] = {"until": until, "link": link}
    db.save()
    
    time_str = "навсегда" if until is None else f"до {until.strftime('%Y-%m-%d %H:%M')} МСК"
    update.message.reply_text(f"✅ Обязательная подписка на {link} установлена {time_str}!")

def back_to_main(update: Update, context: CallbackContext):
    query = update.callback_query
    query.answer()
    
    try:
        query.message.delete()
    except:
        pass
    
    user_id = query.from_user.id
    photo = download_image_sync(PRIVATE_PHOTO_URL)
    keyboard = [
        [InlineKeyboardButton("🛍 МЕТРО ШОП", url=CHANNEL_LINK)],
        [InlineKeyboardButton("👥 СОПРОВОЖДЕНИЯ", callback_data="sopr_menu")],
        [InlineKeyboardButton("👕 ВЕЩИ", callback_data="things_menu")],
        [InlineKeyboardButton("👥 РЕФЕРАЛЫ", callback_data="referral_menu")],
        [InlineKeyboardButton("👤 ПРОФИЛЬ", callback_data="profile_menu")],
        [InlineKeyboardButton("💬 МЕНЕДЖЕР", url=MANAGER_LINK)]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)

    if photo:
        context.bot.send_photo(chat_id=user_id, photo=photo, caption=WELCOME_TEXT, reply_markup=reply_markup)
    else:
        context.bot.send_message(chat_id=user_id, text=WELCOME_TEXT, reply_markup=reply_markup)

# ---------- ЗАПУСК БОТА ----------
def main():
    logger.info("🚀 Запуск бота...")

    # Проверка канала
    try:
        url = f"https://api.telegram.org/bot{BOT_TOKEN}/getChat?chat_id={CHANNEL_ID}"
        response = requests.get(url).json()
        if response.get('ok'):
            logger.info(f"✅ Канал доступен: {response['result'].get('title')}")
    except:
        pass

    # Проверка пропущенных сообщений
    now = datetime.now(MSK_TZ)
    if now.hour >= 10 and now.hour < 22:
        threading.Thread(target=send_morning, args=(True,)).start()
    elif now.hour >= 22:
        threading.Thread(target=send_evening, args=(True,)).start()

    # Планировщик - ЗАПУСКАЕМ ТОЛЬКО РАЗ
    if not scheduler.running:
        scheduler.add_job(send_morning, CronTrigger(hour=10, minute=0, timezone=MSK_TZ), id="morning_job", replace_existing=True)
        scheduler.add_job(send_evening, CronTrigger(hour=22, minute=0, timezone=MSK_TZ), id="evening_job", replace_existing=True)
        scheduler.start()
        logger.info("⏰ Планировщик запущен")

    # Updater
    updater = Updater(BOT_TOKEN)
    dp = updater.dispatcher

    # Команды
    dp.add_handler(CommandHandler("start", start))
    dp.add_handler(CommandHandler("sopr", add_sopr))
    dp.add_handler(CommandHandler("things", add_thing))
    dp.add_handler(CommandHandler("piar", piar_command))

    # Callback-обработчики
    dp.add_handler(CallbackQueryHandler(sopr_menu, pattern="^sopr_menu$"))
    dp.add_handler(CallbackQueryHandler(things_menu, pattern="^things_menu$"))
    dp.add_handler(CallbackQueryHandler(referral_menu, pattern="^referral_menu$"))
    dp.add_handler(CallbackQueryHandler(profile_menu, pattern="^profile_menu$"))
    dp.add_handler(CallbackQueryHandler(back_to_main, pattern="^back_to_main$"))
    dp.add_handler(CallbackQueryHandler(check_subscription_callback, pattern="^check_sub_"))
    dp.add_handler(CallbackQueryHandler(sopr_detail, pattern="^sopr_"))
    dp.add_handler(CallbackQueryHandler(thing_detail, pattern="^thing_"))
    dp.add_handler(CallbackQueryHandler(buy_item, pattern="^buy_"))
    dp.add_handler(CallbackQueryHandler(confirm_payment, pattern="^confirm_"))
    dp.add_handler(CallbackQueryHandler(paid, pattern="^paid_"))
    dp.add_handler(CallbackQueryHandler(owner_confirm, pattern="^confirm_owner_"))
    dp.add_handler(CallbackQueryHandler(owner_reject, pattern="^reject_owner_"))

    logger.info("✅ Бот запущен! Пиши /start в личку - работает!")
    logger.info(f"👤 Ссылка на бота: @KrastuMetroShop_bot")

    updater.start_polling()
    updater.idle()

if __name__ == "__main__":
    main()
