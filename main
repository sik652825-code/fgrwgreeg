import logging
import threading
import requests
import sys
import types
from datetime import datetime
import pytz
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Updater, CommandHandler, CallbackQueryHandler
from apscheduler.schedulers.background import BackgroundScheduler
from apscheduler.triggers.cron import CronTrigger
import io

# ========== ЭМУЛЯЦИЯ imghdr ДЛЯ PYTHON 3.13 ==========
# (Нужно для совместимости, если у вас Python 3.13)
imghdr_module = types.ModuleType('imghdr')
def what(file, h=None):
    return None
imghdr_module.what = what
sys.modules['imghdr'] = imghdr_module
# ====================================================

# ==================== НАСТРОЙКИ ====================
BOT_TOKEN = "8678148131:AAEJbW2q6L6tyeXEkTdhYB9ywAVsb1EFTGk"
CHANNEL_ID = -1002761838993
CHANNEL_LINK = "https://t.me/KrastuMetroShop"
MANAGER_LINK = "https://t.me/KrastuManager"

# НОВЫЕ ССЫЛКИ ДЛЯ КНОПОК
SOPR_LINK = "https://t.me/krastu1"          # Канал для сопровождения
THINGS_LINK = "https://t.me/PriceKrastu"    # Канал для вещей (прайс)
REVIEWS_LINK = "https://t.me/KrastuReviews" # Канал с отзывами

# НОВАЯ ССЫЛКА НА ФОТО ДЛЯ ЛИЧНЫХ СООБЩЕНИЙ
PRIVATE_PHOTO_URL = "https://i.ibb.co/Y7FB9kFH/IMG-20260305-192810-698.jpg"

# ОБЩАЯ КАРТИНКА ДЛЯ КАНАЛА (оставим старую или можно заменить)
CHANNEL_IMAGE_URL = "https://i.ibb.co/xqT0Y3Z3/IMG-20260305-084651-416.jpg"

MSK_TZ = pytz.timezone('Europe/Moscow')
# ====================================================

MORNING_MSG = """✅Принемаем заказы✅
🛒Всё в наличии🛒
⏱Работаю с 10:00 до 22:00 по мск
🛫Быстро и качественно↗️

📥Отзывы📥

@KrastuReviews 

📥Оформить заказ📥

@KrastuManager💬
@KrastuManager💬
@KrastuManager💬"""

EVENING_MSG = """👎Заказы не пренимаем👎
⏱Работаю с 10:00 до 22:00 по мск
🛫Быстро и качественно↗️

Тех. поддержка - @KrastuManager"""

WELCOME_TEXT = """👋 Добро пожаловать в KRASTU metro SHOP!

Выберите интересующий вас раздел:"""

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(message)s')
logger = logging.getLogger(__name__)

scheduler = BackgroundScheduler(timezone=MSK_TZ)

# Флаги для защиты от спама в канале
_sent_morning = False
_sent_evening = False

# ==================== ФУНКЦИИ ДЛЯ КАНАЛА ====================
def download_image_sync(url):
    """Скачивает картинку по URL"""
    try:
        response = requests.get(url, timeout=30)
        if response.status_code == 200:
            logger.info(f"✅ Фото скачано ({len(response.content)} байт)")
            return response.content
    except Exception as e:
        logger.error(f"Ошибка скачивания: {e}")
    return None

def send_morning(is_retro=False):
    """Отправляет утреннее сообщение в канал"""
    global _sent_morning
    if _sent_morning:
        return False

    logger.info("📤 Отправка утреннего в канал...")
    photo = download_image_sync(CHANNEL_IMAGE_URL)
    if not photo:
        logger.error("❌ Не удалось скачать фото")
        return False

    caption = MORNING_MSG
    if is_retro:
        caption = f"⚠️ ПРОПУЩЕНО (10:00)\n\n{MORNING_MSG}"

    try:
        files = {'photo': photo}
        data = {'chat_id': CHANNEL_ID, 'caption': caption}
        response = requests.post(f"https://api.telegram.org/bot{BOT_TOKEN}/sendPhoto", files=files, data=data)
        if response.status_code == 200:
            logger.info("✅ Утреннее в канал отправлено!")
            _sent_morning = True
            return True
        else:
            logger.error(f"❌ Ошибка Telegram: {response.text}")
            return False
    except Exception as e:
        logger.error(f"Ошибка: {e}")
        return False

def send_evening(is_retro=False):
    """Отправляет вечернее сообщение в канал"""
    global _sent_evening
    if _sent_evening:
        return False

    logger.info("📤 Отправка вечернего в канал...")
    photo = download_image_sync(CHANNEL_IMAGE_URL)
    if not photo:
        logger.error("❌ Не удалось скачать фото")
        return False

    caption = EVENING_MSG
    if is_retro:
        caption = f"⚠️ ПРОПУЩЕНО (22:00)\n\n{EVENING_MSG}"

    try:
        files = {'photo': photo}
        data = {'chat_id': CHANNEL_ID, 'caption': caption}
        response = requests.post(f"https://api.telegram.org/bot{BOT_TOKEN}/sendPhoto", files=files, data=data)
        if response.status_code == 200:
            logger.info("✅ Вечернее в канал отправлено!")
            _sent_evening = True
            return True
        else:
            logger.error(f"❌ Ошибка Telegram: {response.text}")
            return False
    except Exception as e:
        logger.error(f"Ошибка: {e}")
        return False

# ==================== КОМАНДЫ В ЛИЧКЕ ====================
def start(update: Update, context):
    """Обработчик команды /start"""
    # КНОПКИ - ТЕПЕРЬ ВСЕ ВЕДУТ ПО ССЫЛКАМ
    keyboard = [
        [InlineKeyboardButton("🛍 МЕТРО ШОП", url=CHANNEL_LINK)],
        [InlineKeyboardButton("👥 СОПРОВОЖДЕНИЕ", url=SOPR_LINK)],      # Новая ссылка
        [InlineKeyboardButton("👕 ВЕЩИ", url=THINGS_LINK)],              # Новая ссылка
        [InlineKeyboardButton("📥 ОТЗЫВЫ", url=REVIEWS_LINK)],
        [InlineKeyboardButton("💬 МЕНЕДЖЕР", url=MANAGER_LINK)]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)

    # НОВАЯ ФОТОГРАФИЯ ДЛЯ ЛИЧНЫХ СООБЩЕНИЙ
    photo = download_image_sync(PRIVATE_PHOTO_URL)
    if photo:
        # Отправляем фото с подписью и кнопками
        context.bot.send_photo(chat_id=update.effective_chat.id, photo=photo, caption=WELCOME_TEXT, reply_markup=reply_markup)
    else:
        # Если фото не загрузилось, отправляем только текст
        update.message.reply_text(WELCOME_TEXT, reply_markup=reply_markup)

# ==================== ЗАПУСК ====================
def main():
    logger.info("🚀 Запуск бота...")

    # Проверка доступности канала (необязательно, но полезно)
    try:
        url = f"https://api.telegram.org/bot{BOT_TOKEN}/getChat?chat_id={CHANNEL_ID}"
        response = requests.get(url).json()
        if response.get('ok'):
            logger.info(f"✅ Канал доступен: {response['result'].get('title')}")
        else:
            logger.warning("⚠️ Бот не в канале, но ЛС будет работать!")
    except Exception as e:
        logger.warning(f"⚠️ Не удалось проверить канал: {e}")

    # Проверка пропущенных сообщений ПРИ ЗАПУСКЕ
    now = datetime.now(MSK_TZ)
    today = now.date()

    # Утренняя проверка (если сейчас >= 10:00 и утреннее ещё не отправляли сегодня)
    if now.hour >= 10:
        # Запускаем отправку в отдельном потоке, чтобы не задерживать запуск бота
        threading.Thread(target=send_morning, args=(True,)).start()

    # Вечерняя проверка (если сейчас >= 22:00 и вечернее ещё не отправляли сегодня)
    if now.hour >= 22:
        threading.Thread(target=send_evening, args=(True,)).start()

    # ПЛАНИРОВЩИК (для точной отправки в будущем)
    scheduler.add_job(send_morning, CronTrigger(hour=10, minute=0, timezone=MSK_TZ))
    scheduler.add_job(send_evening, CronTrigger(hour=22, minute=0, timezone=MSK_TZ))
    scheduler.start()

    # UPDATER
    updater = Updater(BOT_TOKEN)
    dp = updater.dispatcher

    # Обработчик команд
    dp.add_handler(CommandHandler("start", start))

    logger.info("✅ Бот запущен! Пиши /start в личку - работает!")
    logger.info(f"👤 Ссылка на бота: @KrastuMetroShop_bot")

    updater.start_polling()
    updater.idle()

if __name__ == "__main__":
    main()
