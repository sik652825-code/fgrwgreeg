# ==================== БАЗА ДАННЫХ ====================
DATA_FILE = "bot_data.pkl"

class Database:
    def __init__(self):
        self.sopr_items = {}
        self.things_items = {}
        self.orders = {}
        self.users = {}
        self.next_id = 1
        self.pending_subscriptions = {}

    def save(self):
        with open(DATA_FILE, 'wb') as f:
            pickle.dump(self, f)

    @staticmethod
    def load():
        try:
            if os.path.exists(DATA_FILE):
                with open(DATA_FILE, 'rb') as f:
                    return pickle.load(f)
        except:
            pass
        return Database()

db = Database.load()
scheduler = BackgroundScheduler(timezone=MSK_TZ)

_sent_morning = False
_sent_evening = False

# ---------- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ----------
def download_image_sync(url):
    try:
        response = requests.get(url, timeout=30)
        if response.status_code == 200:
            logger.info(f"✅ Фото скачано ({len(response.content)} байт)")
            return response.content
    except Exception as e:
        logger.error(f"Ошибка скачивания: {e}")
    return None

def get_user(user_id):
    if user_id not in db.users:
        db.users[user_id] = {"balance": 0.0, "referrals": [], "referred_by": None}
        db.save()
    return db.users[user_id]

def generate_referral_link(user_id):
    return f"https://t.me/{(__import__('telegram').Bot(BOT_TOKEN).username)}?start=ref_{user_id}"

def check_subscription(user_id, chat_id, bot):
    try:
        member = bot.get_chat_member(chat_id, user_id)
        return member.status in ['member', 'administrator', 'creator']
    except:
        return False

# ---------- ФУНКЦИИ ДЛЯ КАНАЛА ----------
def send_morning(is_retro=False):
    global _sent_morning
    if _sent_morning:
        return False
    logger.info("📤 Отправка утреннего в канал...")
    photo = download_image_sync(CHANNEL_IMAGE_URL)
    if not photo:
        return False
    caption = MORNING_MSG
    if is_retro:
        caption = f"⚠️ ПРОПУЩЕНО (10:00)\n\n{MORNING_MSG}"
    try:
        files = {'photo': photo}
        data = {'chat_id': CHANNEL_ID, 'caption': caption}
        requests.post(f"https://api.telegram.org/bot{BOT_TOKEN}/sendPhoto", files=files, data=data)
        _sent_morning = True
        return True
    except:
        return False

def send_evening(is_retro=False):
    global _sent_evening
    if _sent_evening:
        return False
    logger.info("📤 Отправка вечернего в канал...")
    photo = download_image_sync(CHANNEL_IMAGE_URL)
    if not photo:
        return False
    caption = EVENING_MSG
    if is_retro:
        caption = f"⚠️ ПРОПУЩЕНО (22:00)\n\n{EVENING_MSG}"
    try:
        files = {'photo': photo}
        data = {'chat_id': CHANNEL_ID, 'caption': caption}
        requests.post(f"https://api.telegram.org/bot{BOT_TOKEN}/sendPhoto", files=files, data=data)
        _sent_evening = True
        return True
    except:
        return False

# ---------- ОБРАБОТЧИК КОМАНДЫ /start ----------
def start(update: Update, context: CallbackContext):
    user = update.effective_user
    user_id = user.id
    args = context.args

    if args and args[0].startswith('ref_'):
        try:
            referrer_id = int(args[0].split('_')[1])
            if referrer_id != user_id:
                if user_id not in db.users or not db.users[user_id].get('referred_by'):
                    get_user(user_id)
                    get_user(referrer_id)
                    db.users[user_id]['referred_by'] = referrer_id
                    db.users[referrer_id]['referrals'].append(user_id)
                    db.save()
                    context.user_data['pending_referrer'] = referrer_id
        except:
            pass

    # Проверка обязательных подписок
    need_to_subscribe = None
    for chat_id_str, sub_info in db.pending_subscriptions.items():
        chat_id = int(chat_id_str)
        if sub_info['until'] and sub_info['until'] < datetime.now(MSK_TZ):
            continue
        if not check_subscription(user_id, chat_id, context.bot):
            need_to_subscribe = (chat_id, sub_info['link'])
            break

    if need_to_subscribe:
        chat_id, link = need_to_subscribe
        keyboard = [
            [InlineKeyboardButton("✅ Я ПОДПИСАЛСЯ", callback_data=f"check_sub_{chat_id}")],
            [InlineKeyboardButton("🔍 ПЕРЕЙТИ", url=link)]
        ]
        update.message.reply_text(
            f"❌ Для доступа к боту необходимо подписаться на этот канал:\n{link}\n\nПосле подписки нажмите кнопку ниже.",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )
        return

    # Основное меню
    photo = download_image_sync(PRIVATE_PHOTO_URL)
    keyboard = [
        [InlineKeyboardButton("🛍 МЕТРО ШОП", url=CHANNEL_LINK)],
        [InlineKeyboardButton("👥 СОПРОВОЖДЕНИЯ", callback_data="sopr_menu")],
        [InlineKeyboardButton("👕 ВЕЩИ", callback_data="things_menu")],
        [InlineKeyboardButton("👥 РЕФЕРАЛЫ", callback_data="referral_menu")],
        [InlineKeyboardButton("👤 ПРОФИЛЬ", callback_data="profile_menu")],
        [InlineKeyboardButton("💬 МЕНЕДЖЕР", url=MANAGER_LINK)]
    ]
    reply_markup = InlineKeyboardMarkup(keyboard)

    if photo:
        context.bot.send_photo(chat_id=update.effective_chat.id, photo=photo, caption=WELCOME_TEXT, reply_markup=reply_markup)
    else:
        update.message.reply_text(WELCOME_TEXT, reply_markup=reply_markup)

# ---------- ПРОВЕРКА ПОДПИСКИ ----------
def check_subscription_callback(update: Update, context: CallbackContext):
    query = update.callback_query
    user_id = query.from_user.id
    data = query.data
    query.answer()

    if data.startswith('check_sub_'):
        chat_id = int(data.split('_')[2])

        if check_subscription(user_id, chat_id, context.bot):
            if 'pending_referrer' in context.user_data:
                referrer_id = context.user_data['pending_referrer']
                if referrer_id in db.users and user_id in db.users and db.users[user_id].get('referred_by') == referrer_id:
                    db.users[referrer_id]['balance'] += REFERRAL_BONUS
                    db.save()
                    context.bot.send_message(chat_id=referrer_id, text=f"🎉 Вам начислен 1₽ за нового реферала!")
                context.user_data.pop('pending_referrer', None)

            # Удаляем сообщение с проверкой (с обработкой ошибки)
            try:
                query.message.delete()
            except:
                pass
                
            # Создаем новое сообщение для start
            context.bot.send_message(
                chat_id=user_id,
                text="✅ Подписка подтверждена! Загружаю меню..."
            )
            # Создаем фейковый update для start
            fake_update = Update(update.update_id)
            fake_update.effective_user = update.effective_user
            fake_update.effective_chat = update.effective_chat
            fake_update.message = type('obj', (object,), {
                'reply_text': lambda text, reply_markup=None: context.bot.send_message(
                    chat_id=user_id, text=text, reply_markup=reply_markup
                )
            })
            start(fake_update, context)
        else:
            query.answer("❌ Вы еще не подписались!", show_alert=True)

# ---------- МЕНЮ СОПРОВОЖДЕНИЙ ----------
def sopr_menu(update: Update, context: CallbackContext):
    query = update.callback_query
    query.answer()
    
    # Удаляем старое сообщение (с обработкой ошибки)
    try:
        query.message.delete()
    except:
        pass
    
    if not db.sopr_items:
        keyboard = [[InlineKeyboardButton("◀ НАЗАД", callback_data="back_to_main")]]
        context.bot.send_message(
            chat_id=query.from_user.id,
            text="📭 Сопровождений пока нет",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )
        return
    
    keyboard = []
    for item_id, item in db.sopr_items.items():
        keyboard.append([InlineKeyboardButton(
            f"{item['name']} - {item['price']}₽", 
            callback_data=f"sopr_{item_id}"
        )])
    keyboard.append([InlineKeyboardButton("◀ НАЗАД", callback_data="back_to_main")])
    
    context.bot.send_message(
        chat_id=query.from_user.id,
        text="👥 Выберите сопровождение:",
        reply_markup=InlineKeyboardMarkup(keyboard)
    )

def sopr_detail(update: Update, context: CallbackContext):
    query = update.callback_query
    query.answer()
    
