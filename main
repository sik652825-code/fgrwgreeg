from apscheduler.triggers.cron import CronTrigger
import io

# ========== ЭМУЛЯЦИЯ imghdr ДЛЯ PYTHON 3.13 ==========
# СОЗДАЕМ ФАЛЬШИВЫЙ МОДУЛЬ imghdr
