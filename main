    text = f"👥 **Реферальная система**\n\n🔗 **Ваша ссылка:**\n`{ref_link}`"
    keyboard = [[InlineKeyboardButton("◀ НАЗАД", callback_data="back_to_main")]]
    
    context.bot.send_message(
        chat_id=user_id,
        text=text,
        reply_markup=InlineKeyboardMarkup(keyboard),
        parse_mode='Markdown'
    )

