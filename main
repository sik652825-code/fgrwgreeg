# ---------- ПОКУПКА ----------
def buy_item(update: Update, context: CallbackContext):
    query = update.callback_query
    query.answer()
    
    data_parts = query.data.split("_")
    item_type = data_parts[1]
    item_id = data_parts[2]
    item = db.sopr_items.get(item_id) if item_type == 'sopr' else db.things_items.get(item_id)
    
    if not item:
        try:
            query.message.delete()
        except:
            pass
        context.bot.send_message(
            chat_id=query.from_user.id,
            text="❌ Товар не найден"
        )
        return
    
    try:
        query.message.delete()
    except:
        pass
    
    keyboard = [
        [InlineKeyboardButton("✅ ДА", callback_data=f"confirm_{item_type}_{item_id}")],
        [InlineKeyboardButton("❌ НЕТ", callback_data=f"{item_type}_menu")]
    ]
    
    context.bot.send_message(
        chat_id=query.from_user.id,
        text=f"❓ Хотите купить {item['name']} за {item['price']}₽?",
        reply_markup=InlineKeyboardMarkup(keyboard)
    )

def confirm_payment(update: Update, context: CallbackContext):
    query = update.callback_query
    query.answer()
    
    data_parts = query.data.split("_")
    item_type = data_parts[1]
    item_id = data_parts[2]
    item = db.sopr_items.get(item_id) if item_type == 'sopr' else db.things_items.get(item_id)
    
    if not item:
        try:
            query.message.delete()
        except:
            pass
        context.bot.send_message(
            chat_id=query.from_user.id,
            text="❌ Товар не найден"
        )
        return

    order_id = f"{item_type}_{item_id}_{datetime.now().timestamp()}"
    db.orders[order_id] = {
        "user_id": query.from_user.id,
        "username": query.from_user.username or "нет юзернейма",
        "type": item_type,
        "item": item,
        "status": "waiting_payment"
    }
    db.save()

    try:
        query.message.delete()
    except:
        pass

    keyboard = [
        [InlineKeyboardButton("💳 Я ПЕРЕВЕЛ", callback_data=f"paid_{order_id}")],
        [InlineKeyboardButton("◀ ОТМЕНА", callback_data=f"{item_type}_menu")]
    ]
    payment_text = f"""💳 Реквизиты для оплаты:

+7 958 261 58 16
🏦 Сбер-банк
Получатель: ДАНИИЛ Б.

Сумма: {item['price']}₽
💰 Ваш баланс: {get_user(query.from_user.id)['balance']}₽

После перевода нажмите "Я ПЕРЕВЕЛ" """
    
    context.bot.send_message(
        chat_id=query.from_user.id,
        text=payment_text,
        reply_markup=InlineKeyboardMarkup(keyboard)
    )

def paid(update: Update, context: CallbackContext):
    query = update.callback_query
    query.answer()
    
    order_id = query.data.split("_")[1]
    order = db.orders.get(order_id)
    if not order:
        try:
            query.message.delete()
        except:
            pass
        context.bot.send_message(
            chat_id=query.from_user.id,
            text="❌ Заказ не найден"
        )
        return

    order['status'] = "waiting_confirmation"
    db.save()

    username = query.from_user.username or f"id{query.from_user.id}"
    item_name = order['item']['name']
    item_price = order['item']['price']
    item_type_ru = "сопровождение" if order['type'] == 'sopr' else "вещь"

    # Уведомление владельцам
    for owner_id in OWNER_IDS:
        try:
            text = f"💰 Новый перевод!\n\nТовар: {item_name}\nЦена: {item_price}₽\nПокупатель: @{username}\nТип: {item_type_ru}"
            keyboard = [
                [
                    InlineKeyboardButton("✅ ДА", callback_data=f"confirm_owner_{order_id}"),
                    InlineKeyboardButton("❌ НЕТ", callback_data=f"reject_owner_{order_id}")
                ]
            ]
            context.bot.send_message(chat_id=owner_id, text=text, reply_markup=InlineKeyboardMarkup(keyboard))
        except:
            pass

    # Сообщение в общий чат
    try:
        chat_text = f"🛒 Новая покупка!\nПользователь @{username} купил {item_type_ru} - {item_name}"
        context.bot.send_message(chat_id=CHAT_ID, text=chat_text)
    except:
        pass

    try:
        query.message.delete()
    except:
        pass
    
    context.bot.send_message(
        chat_id=query.from_user.id,
        text="✅ Заявка отправлена владельцу! Ожидайте подтверждения."
    )

def owner_confirm(update: Update, context: CallbackContext):
    query = update.callback_query
    query.answer()

    if query.from_user.id not in OWNER_IDS:
        query.edit_message_text("⛔ Нет прав")
        return

    order_id = query.data.split("_")[2]
    order = db.orders.get(order_id)
    if not order:
        query.edit_message_text("❌ Заказ не найден")
        return

    order['status'] = "confirmed"
    db.save()

    username = order['username']
    item_name = order['item']['name']
    item_type_ru = "сопровождение" if order['type'] == 'sopr' else "вещь"

    # Сообщение покупателю
    try:
        context.bot.send_message(
            chat_id=order['user_id'],
            text=f"✅ Оплата подтверждена!\n\nХорошо, у вас человек купил {item_type_ru} '{item_name}'.\nНайдите команду для {item_type_ru} удачи!"
        )
    except:
        pass

    # Сообщение в чат
    try:
        chat_text = f"✅ Подтверждена покупка!\n\n👤 Покупатель: @{username}\n📦 Товар: {item_name} ({item_type_ru})\n\n👥 Уважаемые сопровождающие, примите заказ в работу!"
        context.bot.send_message(chat_id=CHAT_ID, text=chat_text)
    except:
        pass

    query.edit_message_text(text="✅ Подтверждено!")

def owner_reject(update: Update, context: CallbackContext):
    query = update.callback_query
    query.answer()

    if query.from_user.id not in OWNER_IDS:
        query.edit_message_text("⛔ Нет прав")
        return

    order_id = query.data.split("_")[2]
    order = db.orders.get(order_id)
    if not order:
        query.edit_message_text("❌ Заказ не найден")
        return

    order['status'] = "rejected"
    db.save()

    # Сообщение покупателю
    try:
        context.bot.send_message(
            chat_id=order['user_id'],
            text="❌ Оплата не подтверждена. Свяжитесь с @KrastuManager"
        )
    except:
        pass

    query.edit_message_text(text="❌ Отклонено")

def referral_menu(update: Update, context: CallbackContext):
