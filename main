MORNING_HOUR = 10
MORNING_MINUTE = 0
EVENING_HOUR = 22
EVENING_MINUTE = 0

# ==================== СООБЩЕНИЯ ====================
MORNING_MESSAGE = """✅Принемаем заказы✅
